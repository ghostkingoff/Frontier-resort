# ============================================================
# .gitignore —— 边境度假村（Godot 4.7）
# 说明：末尾带 / 表示忽略整个文件夹；以 / 开头表示只匹配根目录
# ============================================================

# ---------- Godot 引擎自动生成（删掉可随时重建，不入库）----------
# 导入缓存、着色器缓存、脚本类缓存、UID 缓存、编辑器状态等
.godot/

# 安装 Android 构建模板后由编辑器生成
/android/

# ---------- 本项目运行 / 调试产生的临时文件 ----------
# tools/ 下截图脚本、自检脚本的输出目录
.tmp/

# ---------- 导出与打包产物 ----------
# 前面加 / 只匹配根目录，避免将来误伤同名的源码目录
/export/
/exports/
/build/
/dist/

# ---------- 编辑器 / 系统垃圾文件 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*~
